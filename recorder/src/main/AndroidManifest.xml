<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stand-ins for the head unit's runtime vehicle permissions, so the emulator behaves like a car:
         calls are refused until the app has been allowed "Car controls". -->
    <permission android:name="android.permission.BYDAUTO_AC_COMMON" android:protectionLevel="dangerous" android:label="control the air conditioning" />
    <permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" android:protectionLevel="dangerous" android:label="control windows, roof and trunk" />
    <permission android:name="android.permission.BYDAUTO_SETTING_COMMON" android:protectionLevel="dangerous" android:label="control seats and vehicle settings" />
    <permission android:name="android.permission.BYDAUTO_LIGHT_COMMON" android:protectionLevel="dangerous" android:label="control the lights" />
    <permission android:name="android.permission.BYDAUTO_ENERGY_COMMON" android:protectionLevel="dangerous" android:label="change driving modes" />
    <permission android:name="android.permission.BYDAUTO_DOOR_LOCK_COMMON" android:protectionLevel="dangerous" android:label="lock and unlock the doors" />
    <permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" android:protectionLevel="dangerous" android:label="read the instrument cluster" />
    <permission android:name="android.permission.BYDAUTO_PANORAMA_COMMON" android:protectionLevel="dangerous" android:label="show the 360° cameras" />
    <permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" android:protectionLevel="dangerous" android:label="read charging state" />

    <application
        android:allowBackup="true"
        android:label="BYD Mock Service"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <activity android:name=".RecorderActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives every BYD API call forwarded by the instrumented impl. -->
        <receiver android:name=".RecordReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.offline.bydmock.RECORD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
