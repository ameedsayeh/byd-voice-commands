<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback only. INTERNET is required because Android guards every socket() — including
         localhost — behind it, and the self-setup ADB client talks to the car's own adbd on
         localhost:5555 (see setup/AdbBootstrap.kt). The app makes no outbound network calls; the
         Moonshine model downloader stays unused (models are bundled). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Hand commands to the BYD voice assistant (it holds the signature vehicle permissions).
         This one is a normal permission declared by com.byd.autovoice. -->
    <uses-permission android:name="com.android.permission.BYD_AUTO_MATED_TEST" />

    <!-- Offline mic + always-ready service -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Voice pill overlay; "screen brightness" commands -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" tools:ignore="ProtectedPermissions" />

    <!-- BYD DiLink vehicle API. The *_COMMON ones are runtime permissions on DiLink: the app asks for
         them with Android's permission dialog on first start (CarPermissions). -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_ADAS_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ADAS_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_DOOR_LOCK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_DOOR_LOCK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_DOOR_LOCK_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_PANORAMA_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_PANORAMA_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_PANORAMA_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_REAR_VIEW_MIRROR_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_REAR_VIEW_MIRROR_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_SENSOR_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SENSOR_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_SPECIAL_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SPECIAL_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_WIPER_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_WIPER_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_SET" />

    <!-- Package visibility: offline TTS engines, and launchable apps for "open <app>" -->
    <queries>
        <package android:name="com.byd.autovoice" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BydVoice">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".platform.ScreenOffActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.BydVoice.ScreenOff" />

        <!-- exported so the steering-wheel button (via Di+ / any launcher shell) can start a listen:
             am start-foreground-service -n com.offline.bydvoice/.service.VoiceService -a com.offline.bydvoice.action.TRIGGER_LISTEN -->
        <service
            android:name=".service.VoiceService"
            android:exported="true"
            android:foregroundServiceType="microphone" />

        <!-- Steering-wheel mic button (+ split-screen global action). Enabled by the user in Accessibility. -->
        <service
            android:name=".service.KeyButtonService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_keys" />
        </service>

        <!-- Wheel button via a broadcast: am broadcast -a com.offline.bydvoice.action.START_LISTEN -->
        <receiver
            android:name=".service.TriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offline.bydvoice.action.START_LISTEN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
